<configuration>

    <!-- ================================================= -->
    <!-- Application properties                            -->
    <!-- ================================================= -->

    <property name="LOG_DIR"
              value="${mediation.log.directory:-logs}"/>

    <property name="PROCESS_NAME"
              value="${mediation.process.name:-mediation-engine}"/>

    <!-- Independent bounded queue capacities -->

    <property name="CONSOLE_QUEUE_SIZE"
              value="${mediation.logging.console-queue-size:-8192}"/>

    <property name="DETAIL_QUEUE_SIZE"
              value="${mediation.logging.detail-queue-size:-16384}"/>

    <property name="ERROR_QUEUE_SIZE"
              value="${mediation.logging.error-queue-size:-4096}"/>

    <property name="MAX_FLUSH_TIME"
              value="${mediation.logging.max-flush-time-ms:-5000}"/>


    <!-- ================================================= -->
    <!-- 1. Console Output                                 -->
    <!-- ================================================= -->

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n
            </pattern>
        </encoder>

    </appender>


    <!-- ================================================= -->
    <!-- 2. Detail File                                    -->
    <!-- DEBUG + INFO + WARN                               -->
    <!-- ================================================= -->

    <appender name="DETAIL_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_DIR}/${PROCESS_NAME}-detail.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_DIR}/archive/${PROCESS_NAME}-detail.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>50MB</maxFileSize>

            <maxHistory>14</maxHistory>

            <totalSizeCap>2GB</totalSizeCap>

        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n
            </pattern>
        </encoder>

    </appender>


    <!-- ================================================= -->
    <!-- 3. Error File                                     -->
    <!-- ERROR only                                        -->
    <!-- ================================================= -->

    <appender name="ERROR_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_DIR}/${PROCESS_NAME}-error.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_DIR}/archive/${PROCESS_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>50MB</maxFileSize>

            <maxHistory>14</maxHistory>

            <totalSizeCap>2GB</totalSizeCap>

        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n
            </pattern>
        </encoder>

    </appender>


    <!-- ================================================= -->
    <!-- 4. Asynchronous Console Appender                  -->
    <!-- ================================================= -->

    <appender name="ASYNC_CONSOLE"
              class="ch.qos.logback.classic.AsyncAppender">

        <queueSize>${CONSOLE_QUEUE_SIZE}</queueSize>

        <!-- Start discarding DEBUG/INFO only when the queue is nearly full. -->
        <discardingThreshold>${mediation.logging.console-discarding-threshold:-1024}</discardingThreshold>

        <!-- Never block application threads when queue is full -->
        <neverBlock>true</neverBlock>

        <maxFlushTime>${MAX_FLUSH_TIME}</maxFlushTime>

        <includeCallerData>false</includeCallerData>

        <appender-ref ref="CONSOLE"/>

    </appender>


    <!-- ================================================= -->
    <!-- 5. Asynchronous Detail Appender                   -->
    <!-- DEBUG + INFO + WARN                               -->
    <!-- ================================================= -->

    <appender name="ASYNC_DETAIL"
              class="ch.qos.logback.classic.AsyncAppender">

        <queueSize>${DETAIL_QUEUE_SIZE}</queueSize>

        <!-- Keep detail records until the queue is nearly full. -->
        <discardingThreshold>${mediation.logging.detail-discarding-threshold:-2048}</discardingThreshold>

        <neverBlock>true</neverBlock>

        <maxFlushTime>${MAX_FLUSH_TIME}</maxFlushTime>

        <includeCallerData>false</includeCallerData>

        <!-- Reject ERROR before entering the asynchronous queue -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">

            <level>ERROR</level>

            <onMatch>DENY</onMatch>

            <onMismatch>NEUTRAL</onMismatch>

        </filter>

        <appender-ref ref="DETAIL_FILE"/>

    </appender>


    <!-- ================================================= -->
    <!-- 6. Asynchronous Error Appender                    -->
    <!-- ERROR only                                        -->
    <!-- ================================================= -->

    <appender name="ASYNC_ERROR"
              class="ch.qos.logback.classic.AsyncAppender">

        <queueSize>${ERROR_QUEUE_SIZE}</queueSize>

        <!-- No early discarding for this ERROR-only queue -->
        <discardingThreshold>0</discardingThreshold>

        <neverBlock>true</neverBlock>

        <maxFlushTime>${MAX_FLUSH_TIME}</maxFlushTime>

        <includeCallerData>false</includeCallerData>

        <!-- Only ERROR events enter this queue -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">

            <level>ERROR</level>

            <onMatch>ACCEPT</onMatch>

            <onMismatch>DENY</onMismatch>

        </filter>

        <appender-ref ref="ERROR_FILE"/>

    </appender>


    <!-- ================================================= -->
    <!-- 7. Application Logger                             -->
    <!-- ================================================= -->

    <logger name="org.prats"
            level="DEBUG"/>


    <!-- ================================================= -->
    <!-- 8. Root Logger                                    -->
    <!-- ================================================= -->

    <root level="ERROR">

        <appender-ref ref="ASYNC_CONSOLE"/>

        <appender-ref ref="ASYNC_DETAIL"/>

        <appender-ref ref="ASYNC_ERROR"/>

    </root>

</configuration>
